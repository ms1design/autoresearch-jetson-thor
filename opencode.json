{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "experimental": {
    "openTelemetry": false
  },
  "default_agent": "Auto Researcher",
  "mcp": {
    "arxiv": {
      "type": "local",
      "enabled": true,
      "command": ["uv", "tool", "run", "arxiv-mcp-server"]
    }
  },
  "permission": {
    "bash": "allow"
  }
}
